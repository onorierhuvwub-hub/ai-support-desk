# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI API Key for GPT Triage & Reply Generation (from https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key

# Optional: Model override (defaults to 'gpt-4o-mini', or 'gpt-4o' for higher quality)
OPENAI_MODEL=gpt-4o-mini
